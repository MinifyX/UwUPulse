      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Training läuft"
          }
        }
      }
    },
    "Workouts are discarded at the end and not saved to Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainings werden am Ende verworfen und nicht in Health gespeichert."
          }
        }
      }
    },
    "Your heart rate only goes to computers you paired, directly over your local network. No cloud, no account, no tracking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Herzfrequenz geht nur an Computer, die du gekoppelt hast, direkt über dein lokales Netzwerk. Keine Cloud, kein Konto, kein Tracking."
          }
        }
      }
    },
    "Your strap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Brustgurt"
          }
        }
      }
    },
    "“%@” is already paired but now presents a different key. Replace it only if you reinstalled UwUPulse on that computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits gekoppelt, meldet sich jetzt aber mit einem anderen Schlüssel. Ersetze ihn nur, wenn du UwUPulse auf diesem Computer neu installiert hast."
          }
        }
      }
    }
  },
  "version": "1.0"
}
